        },
        "path": "/",
        "type": "ws"
      },
      "type": "vmess",
      "security": "auto",
      "uuid": "00000000-0000-0000-0000-000000000000"
    },
    {
      "server": "203.0.113.10",
      "server_port": 443,
      "tag": "vmess-argo-node",
      "tls": {
        "enabled": false,
        "server_name": "example.com",
        "insecure": false,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "headers": {
          "Host": "example.com"
        },
        "path": "/",
        "type": "ws"
      },
      "type": "vmess",
      "security": "auto",
      "uuid": "00000000-0000-0000-0000-000000000000"
    },
    {
      "tag": "proxy",
      "type": "selector",
      "default": "auto",
      "outbounds": [
        "auto",
        "vless-node",
        "vmess-node",
        "hy2-node",
        "tuic-node",
        "anytls-node",
        "vmess-tls-argo-node",
        "vmess-argo-node"
      ]
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [
        "vless-node",
        "vmess-node",
        "hy2-node",
        "tuic-node",
        "anytls-node",
        "vmess-tls-argo-node",
        "vmess-argo-node"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 30,
      "idle_timeout": "30m"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}